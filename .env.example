# Optional. Without a key WITNESS runs rules-only and every fixture still works.
# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq instead (free tier, OpenAI's open-weight gpt-oss models):
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# WITNESS_LLM_TIMEOUT_MS=15000
